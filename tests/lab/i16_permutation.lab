# I16 phase 1a: what darkens DI under permutation sampling (I15: café dim tiles -8..-10 %, EmissiveStrengthTest -0.3 %,
# lamp -1.3 %). Base: shipped + permutation (I15's B) on 5 seeds; each set turns one feature that the converged (unbiased)
# set turns off back off, plus permutation over the converged set itself
base    di=shipped gi=shipped frame=shipped di.permutation=on
seeds   5
cases   cafe.tables cafe.dining guide.emissive guide.lamp
kinds   diBias
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.visibilityShortcut=off
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.fallback=off
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.boilingFilter=off
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.boostSamples=0
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.brdfSamples=0
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.spatialSamples=0
sets    di=shipped gi=shipped frame=shipped di.permutation=on di.materialTest=off
sets    di=shipped gi=shipped frame=shipped di.permutation=on frame.jitter=off
sets    di=converged gi=shipped frame=shipped di.permutation=on
sets    di=converged gi=shipped frame=shipped
sets    di=shipped gi=shipped frame=shipped
